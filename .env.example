# API de FoodPass (solo inicio de sesión). Ejemplo: http://192.168.1.10:3000/api
API_URL=http://127.0.0.1:8000/api/v1/escritorio
# Minutos sin usar el equipo antes de pedir el PIN (por defecto 5)
BLOQUEO_MINUTOS=5

# Base de datos foodpass_v2 (canjes, beneficiarios y reportes, C2.2-04).
# Si DB_HOST está vacío, el escritorio usa la API o el servidor simulado.
DB_HOST=
DB_PORT=3306
DB_NAME=foodpass_v2
DB_USER=fp_escritorio
DB_PASSWORD=
