# API de FoodPass (solo inicio de sesión). En otro equipo: http://192.168.1.10:3000/api
API_URL=http://localhost:3000/api
# Minutos sin usar el equipo antes de pedir el PIN (por defecto 5)
BLOQUEO_MINUTOS=5

# Base de datos foodpass_v2 (canjes, beneficiarios y reportes).
# Con XAMPP en el mismo equipo: DB_USER=root y DB_PASSWORD vacío.
# En producción: el usuario fp_escritorio de sql/C22_04_escritorio.sql.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=foodpass_v2
DB_USER=root
DB_PASSWORD=

# Raciones previstas por servicio y porcentaje para avisar (solo alertan)
RACIONES_DESAYUNO=100
RACIONES_ALMUERZO=125
RACIONES_REFRIGERIO=100
ALERTA_PORCENTAJE=80
