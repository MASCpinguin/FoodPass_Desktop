/* ==========================================================================
   FoodPass Escritorio · Tema basado en la Guía de Estilos y Sistema de Diseño
   de FoodPass (Manual de diseño v2.2, secciones 3 a 7).

   Tokens (no escribir colores fuera de esta lista):
     color-primary      #F97F2D  Naranja Otoñal     text-on-primary #1A1A1A
     color-success      #2F9B34  Verde Jungla       success-text    #1F7A24  success-bg   #E3F4E4
     color-structure    #283618  Verde Selva Negra
     color-surface      #FFFFFF  Blanco Puro
     color-background   #F8F9FA  Gris Neutro Claro
     color-dark         #1E293B  Slate Dark         text-secondary  #64748B
     danger             #B92F2B                     danger-bg       #FDECEA
     warning            #F0AD4E                     warning-bg      #FDF3E1  warning-text #7A5300
     attention-bg       #FEEBDD                     attention-text  #9A4A14
     neutral-bg         #E2E8F0                     neutral-text    #475569  borde #CBD5E1
   Radios: sm 8 px · md 12 px · full 9999 px. Botones POS: alto mínimo 56 px.
   ========================================================================== */

QWidget {
    font-family: "Poppins", "Segoe UI", "Arial", sans-serif;
    font-size: 14px;
    color: #1E293B;
}

QWidget#contenedorPrincipal, QStackedWidget#areaContenido, QWidget#paginaContenido {
    background-color: #F8F9FA;
}

QToolTip { background: #1E293B; color: #FFFFFF; border: none; padding: 6px 8px; }

/* --- Barra lateral (Verde Selva Negra) ----------------------------------- */
QFrame#barraLateral { background-color: #283618; border: none; }
/* Logo oficial, variante para fondos verdes (Manual de diseño 3.6) */
QFrame#placaLogo { background: transparent; border: none; }
QLabel#imagenLogo { background: transparent; }
QLabel#subtituloMarca, QLabel#pieBarra { color: #CBD5E1; font-size: 11px; font-weight: 500; letter-spacing: 1px; }

QPushButton#botonNavegacion {
    outline: none;
    background-color: transparent;
    color: #E2E8F0;
    border: none;
    border-radius: 8px;
    min-height: 56px;
    padding: 0 16px;
    text-align: left;
    font-size: 14px;
    font-weight: 500;
}
QPushButton#botonNavegacion:hover { background-color: #34451F; color: #FFFFFF; }
QPushButton#botonNavegacion:checked { background-color: #F97F2D; color: #1A1A1A; font-weight: 600; }
QPushButton#botonNavegacion:focus { border: 3px solid #F97F2D; }

QFrame#indicadorConexion { background-color: #34451F; border-radius: 8px; }
QLabel#textoConexion { color: #FFFFFF; font-size: 13px; font-weight: 500; }
QLabel#puntoConexion[estado="conectado"] { color: #2F9B34; font-size: 16px; }
QLabel#puntoConexion[estado="sin_conexion"] { color: #F0AD4E; font-size: 16px; }

QFrame#tarjetaOperador { background-color: #34451F; border: none; border-radius: 12px; }
QLabel#etiquetaOperador { color: #CBD5E1; font-size: 11px; font-weight: 500; }
QLabel#nombreOperador { color: #FFFFFF; font-size: 14px; font-weight: 600; }
QPushButton#botonCerrarSesion {
    background-color: transparent; color: #FFFFFF; border: 1px solid #64748B;
    border-radius: 8px; min-height: 40px; font-size: 13px; font-weight: 500;
}
QPushButton#botonCerrarSesion:hover { background-color: #283618; }

/* --- Encabezados ---------------------------------------------------------- */
QLabel#tituloPantalla, QLabel#tituloVentanilla { color: #283618; font-size: 24px; font-weight: 700; }
QLabel#descripcionPantalla, QLabel#subtituloVentanilla { color: #64748B; font-size: 14px; }
QLabel#tituloSeccion { color: #283618; font-size: 18px; font-weight: 600; }
QLabel#textoSecundario { color: #64748B; font-size: 13px; }

/* --- Botones (alto mínimo 56 px, radius-sm) ------------------------------- */
QPushButton {
    outline: none;
    background-color: #FFFFFF; color: #283618; border: 1px solid #CBD5E1;
    border-radius: 8px; min-height: 56px; padding: 0 20px; font-size: 14px; font-weight: 500;
}
QPushButton:hover { background-color: #F1F5F9; }
QPushButton:focus { border: 3px solid #F97F2D; padding: 0 18px; }
QPushButton:disabled { background-color: #E2E8F0; color: #475569; border: none; }

QPushButton[variante="principal"] { background-color: #F97F2D; color: #1A1A1A; border: 3px solid #F97F2D; padding: 0 18px; font-weight: 600; }
QPushButton[variante="principal"]:hover { background-color: #E8701F; border-color: #E8701F; }
QPushButton[variante="principal"]:focus { border: 3px solid #283618; }
QPushButton[variante="principal"]:disabled { background-color: #E2E8F0; color: #475569; border-color: #E2E8F0; }

QPushButton[variante="secundario"] { background-color: #283618; color: #FFFFFF; border: 3px solid #283618; padding: 0 18px; }
QPushButton[variante="secundario"]:hover { background-color: #1F2A12; border-color: #1F2A12; }
QPushButton[variante="secundario"]:focus { border: 3px solid #F97F2D; }

QPushButton[variante="destructivo"] { background-color: #B92F2B; color: #FFFFFF; border: 3px solid #B92F2B; padding: 0 18px; }
QPushButton[variante="destructivo"]:focus { border: 3px solid #283618; }
QPushButton[variante="destructivo"]:hover { background-color: #9E2622; border-color: #9E2622; }
QPushButton[variante="destructivo"]:disabled { background-color: #E2E8F0; color: #475569; border-color: #E2E8F0; }

/* --- Campos ---------------------------------------------------------------- */
QLineEdit, QComboBox, QDateEdit, QSpinBox {
    background-color: #FFFFFF; color: #1E293B; border: 1px solid #CBD5E1;
    border-radius: 8px; min-height: 46px; padding: 0 12px; font-size: 14px;
    selection-background-color: #F97F2D; selection-color: #1A1A1A;
}
QLineEdit:focus, QComboBox:focus, QDateEdit:focus, QSpinBox:focus { border: 2px solid #F97F2D; padding: 0 11px; }
/* Lista desplegable: la flecha tiene su propio espacio y el texto nunca se corta */
QComboBox { padding-right: 40px; }
QComboBox:focus { padding-right: 39px; }
QComboBox::drop-down { subcontrol-origin: padding; subcontrol-position: center right; width: 36px; border: none; background: transparent; }
QDateEdit { padding-right: 40px; }
QDateEdit::drop-down { subcontrol-origin: padding; subcontrol-position: center right; width: 36px; border: none; background: transparent; }
QDateEdit::down-arrow { image: url("{RECURSOS}/icons/flecha_abajo.svg"); width: 16px; height: 16px; }
QComboBox::down-arrow { image: url("{RECURSOS}/icons/flecha_abajo.svg"); width: 16px; height: 16px; }
QLineEdit:disabled, QComboBox:disabled { background-color: #F1F5F9; color: #64748B; }
QComboBox QAbstractItemView { background: #FFFFFF; selection-background-color: #FEEBDD; selection-color: #1E293B; }
QCheckBox { font-size: 14px; spacing: 10px; }
QCheckBox::indicator { width: 22px; height: 22px; }

/* --- Tarjetas y métricas (radius-md, elevación 1) ------------------------- */
QFrame#tarjeta, QFrame#tarjetaMetrica {
    background-color: #FFFFFF; border: 1px solid #E2E8F0; border-radius: 12px;
}
QFrame#tarjetaMetrica[destacada="true"] { background-color: #283618; border: none; }
QLabel#etiquetaMetrica { color: #64748B; font-size: 13px; font-weight: 500; }
QLabel#cifraMetrica { color: #283618; font-size: 40px; font-weight: 700; }
QLabel#detalleMetrica { color: #64748B; font-size: 13px; }
QFrame#tarjetaMetrica[destacada="true"] QLabel#etiquetaMetrica,
QFrame#tarjetaMetrica[destacada="true"] QLabel#detalleMetrica { color: #E2E8F0; }
QFrame#tarjetaMetrica[destacada="true"] QLabel#cifraMetrica { color: #FFFFFF; }

QProgressBar { background-color: #E2E8F0; border: none; border-radius: 4px; max-height: 8px; min-height: 8px; text-align: center; }
QProgressBar::chunk { background-color: #F97F2D; border-radius: 4px; }

/* --- Avisos y badges --------------------------------------------------------- */
QLabel#aviso { border-radius: 12px; padding: 12px 14px; font-size: 13px; font-weight: 500; }
QLabel#aviso[tipo="error"] { background-color: #FDECEA; color: #1E293B; border-left: 4px solid #B92F2B; }
QLabel#aviso[tipo="advertencia"] { background-color: #FDF3E1; color: #7A5300; border-left: 4px solid #F0AD4E; }
QLabel#aviso[tipo="atencion"] { background-color: #FEEBDD; color: #9A4A14; border-left: 4px solid #F97F2D; }
QLabel#aviso[tipo="info"] { background-color: #E3F4E4; color: #1F7A24; border-left: 4px solid #2F9B34; }

QLabel#badge { border-radius: 12px; padding: 3px 12px; font-size: 13px; font-weight: 500; }
QLabel#badge[tipo="canjeado"] { background-color: #E3F4E4; color: #1F7A24; }
QLabel#badge[tipo="ya_recibio"] { background-color: #FEEBDD; color: #9A4A14; }
QLabel#badge[tipo="neutro"] { background-color: #E2E8F0; color: #475569; }
QLabel#badge[tipo="error"] { background-color: #FDECEA; color: #B92F2B; }

/* --- Tablas ------------------------------------------------------------------ */
QTableView, QTableWidget {
    background-color: #FFFFFF; alternate-background-color: #F8F9FA; border: 1px solid #E2E8F0;
    border-radius: 12px; gridline-color: #E2E8F0; font-size: 13px;
    selection-background-color: #FEEBDD; selection-color: #1E293B;
}
QHeaderView::section {
    background-color: #283618; color: #FFFFFF; border: none; padding: 10px 8px;
    font-size: 13px; font-weight: 600;
}
QTableView::item, QTableWidget::item { padding: 6px; }

QScrollBar:vertical { background: transparent; width: 10px; }
QScrollBar::handle:vertical { background: #CBD5E1; border-radius: 5px; min-height: 30px; }
QScrollBar::add-line, QScrollBar::sub-line { height: 0; }

/* --- Ventanilla (Estación 1) ------------------------------------------------- */
QWidget#vistaVentanilla { background-color: #F8F9FA; }

QFrame#contenedorPildoraServicios { background-color: #FFFFFF; border: 1px solid #E2E8F0; border-radius: 30px; }
QPushButton#btnServicioPildora {
    background-color: transparent; color: #283618; border: none; border-radius: 26px;
    min-height: 52px; min-width: 150px; padding: 0 18px; font-size: 14px; font-weight: 500;
}
QPushButton#btnServicioPildora:hover { background-color: #F1F5F9; }
QPushButton#btnServicioPildora:checked { background-color: #283618; color: #FFFFFF; font-weight: 600; }
QPushButton#btnServicioPildora:focus { border: 3px solid #F97F2D; }

QLabel#avisoServicio[activo="false"] {
    background-color: #FDF3E1; color: #7A5300; border-left: 4px solid #F0AD4E;
    border-radius: 12px; padding: 12px 14px; font-weight: 500;
}
QLabel#avisoServicio[activo="true"] {
    background-color: #E3F4E4; color: #1F7A24; border-left: 4px solid #2F9B34;
    border-radius: 12px; padding: 12px 14px; font-weight: 600;
}

QFrame#cajaLecturaQR { background-color: #FFFFFF; border: 3px solid #F97F2D; border-radius: 12px; min-height: 64px; }
QFrame#cajaLecturaQR[habilitado="false"] { border: 3px solid #CBD5E1; background-color: #F1F5F9; }
QLabel#iconoLectura { color: #283618; font-size: 24px; font-weight: 700; }
QLineEdit#inputLecturaQR { background: transparent; border: none; font-size: 18px; font-weight: 600; min-height: 56px; color: #1E293B; }
QLineEdit#inputLecturaQR:disabled { color: #64748B; }
QPushButton#btnAtajoManual { background-color: #283618; color: #FFFFFF; border: none; min-height: 48px; }
QPushButton#btnAtajoManual:disabled { background-color: #E2E8F0; color: #475569; }

QFrame#tarjetaResultado { background-color: #FFFFFF; border: 2px solid #E2E8F0; border-radius: 12px; }
QFrame#tarjetaResultado[estado="reposo"] { border: 2px dashed #CBD5E1; }
QFrame#tarjetaResultado[estado="entregado"] { border: 3px solid #2F9B34; background-color: #FFFFFF; }
QFrame#tarjetaResultado[estado="ya_recibio"],
QFrame#tarjetaResultado[estado="no_beneficiario"],
QFrame#tarjetaResultado[estado="no_reconocido"] { border: 3px solid #B92F2B; background-color: #FDECEA; }
QFrame#tarjetaResultado[estado="error_conexion"] { border: 3px solid #F0AD4E; background-color: #FDF3E1; }
QFrame#tarjetaResultado[estado="anulado"] { border: 3px solid #475569; background-color: #F1F5F9; }

QFrame#recuadroFoto { background-color: #E2E8F0; border: none; border-radius: 100px; }
QLabel#lblSinFoto { color: #475569; font-size: 13px; font-weight: 500; }
QLabel#lblEstadoIcono { font-size: 30px; font-weight: 700; color: #283618; }
QLabel#lblEstadoTitulo { font-size: 24px; font-weight: 700; color: #283618; }
QLabel#lblEstadoTitulo[estado="entregado"] { color: #1F7A24; }
QLabel#lblEstadoTitulo[estado="ya_recibio"],
QLabel#lblEstadoTitulo[estado="no_beneficiario"],
QLabel#lblEstadoTitulo[estado="no_reconocido"] { color: #B92F2B; }
QLabel#lblEstadoTitulo[estado="error_conexion"] { color: #7A5300; }
QLabel#lblEstadoTitulo[estado="anulado"] { color: #475569; }
QLabel#lblNombreAprendiz { color: #1E293B; font-size: 32px; font-weight: 700; }
QLabel#lblNombreAprendiz[estado="reposo"] { color: #64748B; }
QLabel#lblDocumentoAprendiz { color: #1E293B; font-size: 18px; font-weight: 600; }
QLabel#lblChipServicioHora { background-color: #E3F4E4; color: #1F7A24; border-radius: 12px; padding: 4px 14px; font-size: 14px; font-weight: 500; }
QLabel#lblDetallesAprendiz { color: #475569; font-size: 14px; }
QLabel#lblSonidoEstado { color: #64748B; font-size: 13px; }

QFrame#panelLecturas { background-color: #FFFFFF; border: 1px solid #E2E8F0; border-radius: 12px; }
QLabel#filaLectura { color: #1E293B; font-size: 13px; }

/* --- Diálogos (elevación 2) ------------------------------------------------- */
QDialog { background-color: #FFFFFF; }
QLabel#tituloDialogoManual, QLabel#tituloDialogo { color: #283618; font-size: 22px; font-weight: 700; }
QLabel#etiquetaCampoManual, QLabel#etiquetaCampo { color: #1E293B; font-size: 14px; font-weight: 500; }
QLabel#errorDialogo { color: #B92F2B; font-size: 13px; font-weight: 500; }
QLineEdit#inputDocumentoManual, QComboBox#comboMotivoManual { min-height: 50px; font-size: 16px; }
QPushButton#btnConfirmarManual { background-color: #F97F2D; color: #1A1A1A; border: none; font-weight: 600; }
QPushButton#btnConfirmarManual:hover { background-color: #E8701F; }
QPushButton#btnCancelarManual { background-color: #FFFFFF; color: #283618; border: 1px solid #CBD5E1; }

/* --- Inicio de sesión ----------------------------------------------------------- */
QWidget#vistaLogin { background-color: #F8F9FA; }
QFrame#panelMarcaLogin { background-color: #283618; border: none; }
QLabel#subtituloMarcaLogin, QLabel#pieMarcaLogin { color: #CBD5E1; font-size: 11px; font-weight: 500; letter-spacing: 1px; }
QLabel#heroLogin { color: #FFFFFF; font-size: 44px; font-weight: 700; }
QLabel#descripcionMarcaLogin { color: #E2E8F0; font-size: 16px; }
QFrame#tarjetaAcceso { background-color: #FFFFFF; border: 1px solid #E2E8F0; border-radius: 12px; }
QLabel#tituloAcceso { color: #283618; font-size: 24px; font-weight: 700; }
QLabel#descripcionAcceso { color: #64748B; font-size: 14px; }
QLabel#etiquetaCampoLogin { color: #1E293B; font-size: 14px; font-weight: 500; }
QLineEdit#campoLogin { min-height: 48px; font-size: 15px; }
QLineEdit#campoPin { border: 3px solid #F97F2D; border-radius: 12px; min-height: 64px; font-size: 26px; font-weight: 700; }
QLabel#mensajeLogin { border-radius: 12px; padding: 12px 14px; font-size: 13px; font-weight: 500; }
QLabel#mensajeLogin[tipo="error"] { background-color: #FDECEA; color: #1E293B; border-left: 4px solid #B92F2B; }
QLabel#mensajeLogin[tipo="aviso"] { background-color: #FDF3E1; color: #7A5300; border-left: 4px solid #F0AD4E; }
QWidget#vistaLogin QPushButton[variante="principal"] { min-height: 56px; font-size: 15px; }

/* Beneficios del panel de marca del inicio de sesión */
QLabel#puntoMarcaLogin { background-color: #F97F2D; border-radius: 5px; }
QLabel#itemMarcaLogin { color: #E2E8F0; font-size: 15px; font-weight: 500; }
QFrame#separadorAcceso { background-color: #E2E8F0; border: none; }
QLabel#ayudaAcceso { color: #64748B; font-size: 13px; }
QPushButton#botonCerrarSesion, QPushButton#btnServicioPildora { outline: none; }
/* Últimas lecturas desplazables */
QScrollArea#scrollLecturas, QWidget#contenedorLecturas, QWidget#filaLecturaCaja { background: transparent; border: none; }
QLabel#detalleLectura { color: #64748B; font-size: 12px; }
QScrollArea#scrollLecturas QScrollBar:vertical { background: transparent; width: 8px; margin: 0; }
QScrollArea#scrollLecturas QScrollBar::handle:vertical { background: #CBD5E1; border-radius: 4px; min-height: 32px; }
QScrollArea#scrollLecturas QScrollBar::handle:vertical:hover { background: #94A3B8; }
QScrollArea#scrollLecturas QScrollBar::add-line:vertical, QScrollArea#scrollLecturas QScrollBar::sub-line:vertical { height: 0; }
QScrollArea#scrollLecturas QScrollBar::add-page:vertical, QScrollArea#scrollLecturas QScrollBar::sub-page:vertical { background: transparent; }
/* Reporte de entregas: tarjeta de filtros, atajos y totales */
QFrame#tarjetaFiltros { background-color: #FFFFFF; border: 1px solid #E2E8F0; border-radius: 12px; }
QPushButton#chipFiltro {
    outline: none; background-color: #F8F9FA; color: #283618; border: 1px solid #CBD5E1;
    border-radius: 23px; min-height: 46px; max-height: 46px; padding: 0 16px; font-size: 13px; font-weight: 500;
}
QPushButton#chipFiltro:hover { background-color: #FEEBDD; border-color: #F97F2D; }
QLabel#chipTotal {
    background-color: #F1F5F9; color: #475569; border-radius: 17px; padding: 0 14px;
    font-size: 13px; font-weight: 500;
}
QLabel#chipTotal[principal="true"] { background-color: #283618; color: #FFFFFF; font-weight: 600; }
QTableView, QTableWidget { outline: 0; }
